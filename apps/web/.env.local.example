# Copy to .env.local (gitignored). Never commit real secrets.
NEXT_PUBLIC_API_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-tenant
# Must match the Spring Boot JWT_SECRET so middleware can verify tokens.
JWT_SECRET=dev-secret-change-in-production-must-be-at-least-256-bits
